{
  "name": "job-intelligence-mcp-server",
  "version": "1.0.0",
  "description": "MCP server providing job market data tools — Indeed, LinkedIn, TrueUp, Glassdoor, and Levels.fyi",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
